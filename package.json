{
  "name": "@virstak/ui",
  "version": "0.0.4-local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrolikov/virstak-ui.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/copy-styles.mjs",
    "pack:local": "npm run build && npm pack --pack-destination artifacts",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "playwright": "1.51.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "1.75.0"
  }
}
