{
  "name": "@virstak/ui",
  "version": "0.0.7-local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrolikov/virstak-ui.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/copy-styles.mjs",
    "pack:local": "npm run build && npm pack --pack-destination artifacts",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^30.1.3",
    "playwright": "1.51.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "lucide-react": "1.75.0"
  }
}
