{
  "name": "@virstak/ui",
  "version": "1.0.0",
  "description": "VIRSTAK design system for React: UI components, themes and design tokens.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skrolikov/virstak-ui.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/browser.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/styles.css"
    },
    "./components.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/components.css"
    },
    "./tokens.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./themes.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/themes.css"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run test:run",
    "build": "vite build && dts-bundle-generator --no-banner -o dist/index.d.ts src/index.ts && node scripts/copy-styles.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "pack:local": "npm pack --pack-destination artifacts",
    "verify:release": "npm run check && npm run pack:local && node scripts/verify-package.mjs",
    "verify:browser:package": "node scripts/verify-package-browser.mjs",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dts-bundle-generator": "10.0.0",
    "jsdom": "^30.1.3",
    "playwright": "1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "lucide-react": "1.75.0"
  }
}
